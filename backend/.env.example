# Server Configuration

# Port for backend server
PORT=3000

# Frontend URL (CORS) - Must match the URL where frontend is served
# If backend serves frontend on same port: http://localhost:3000
# If different machine: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# Production environment
NODE_ENV=production

# Email recipient for attendance submissions
RECIPIENT_EMAIL=apprentissage@esisar.grenoble-inp.fr
