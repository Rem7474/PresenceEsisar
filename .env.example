# Copier en .env (optionnel : chaque variable a une valeur par défaut).

# Port HTTPS (certificat auto-signé) vers lequel pointe le reverse proxy public
HTTPS_PORT=8443
# Interface d'écoute : 127.0.0.1 si nginx est sur la même machine, 0.0.0.0 s'il est sur une autre
BIND_ADDRESS=127.0.0.1

# Destinataire des attestations
RECIPIENT_EMAIL=apprentissage@esisar.grenoble-inp.fr

# Serveur SMTP : 465 = SSL/TLS, 587 = STARTTLS (le mode est déduit du port)
SMTP_HOST=smtps.esisar.grenoble-inp.fr
SMTP_PORT=465
# Forcer le mode si besoin : true = SSL/TLS, false = STARTTLS
# SMTP_SECURE=
# Mettre "false" uniquement si le serveur SMTP présente un certificat non reconnu
SMTP_TLS_REJECT_UNAUTHORIZED=true
