# Copier en .env (optionnel : chaque variable a une valeur par défaut).

# Port HTTPS (certificat auto-signé) vers lequel pointe le reverse proxy public
HTTPS_PORT=8443
# Interface d'écoute : 127.0.0.1 si nginx est sur la même machine, 0.0.0.0 s'il est sur une autre
BIND_ADDRESS=127.0.0.1

# Destinataire des attestations
RECIPIENT_EMAIL=apprentissage@esisar.grenoble-inp.fr
# Objet du mail envoyé
MAIL_SUBJECT=feuille de présence - 5App

# Envoi direct par SMTP. Mettre "false" pour le désactiver : l'app ne demande alors que le nom
# et propose uniquement l'envoi via l'application e-mail de l'appareil.
SMTP_ENABLED=true

# Identifiants du compte d'envoi SMTP du serveur (ex: Brevo / Sendinblue)
SMTP_USER=
SMTP_PASS=
# Adresse d'expédition des e-mails (expéditeur unique)
# IMPORTANT avec Brevo : cette adresse (ou son domaine) DOIT être validée dans vos expéditeurs Brevo.
SMTP_FROM=presence@esisar.grenoble-inp.fr

# Serveur SMTP : 465 = SSL/TLS, 587 = STARTTLS (le mode est déduit du port)
# Avec Brevo : SMTP_HOST=smtp-relay.brevo.com et SMTP_PORT=587
SMTP_HOST=smtps.esisar.grenoble-inp.fr
SMTP_PORT=465
# Forcer le mode si besoin : true = SSL/TLS, false = STARTTLS
# SMTP_SECURE=
# Mettre "false" uniquement si le serveur SMTP présente un certificat non reconnu
SMTP_TLS_REJECT_UNAUTHORIZED=true
