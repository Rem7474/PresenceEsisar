# Copier en .env (optionnel : chaque variable a une valeur par défaut).

# Nom de domaine public : Caddy obtient alors un certificat Let's Encrypt (ports 80/443 ouverts).
# Laisser "localhost" (ou une IP / un nom local) pour un certificat auto-signé.
DOMAIN=localhost

# Destinataire des attestations
RECIPIENT_EMAIL=apprentissage@esisar.grenoble-inp.fr

# Serveur SMTP (STARTTLS)
SMTP_HOST=smtps.esisar.grenoble-inp.fr
SMTP_PORT=587
# Mettre "false" uniquement si le serveur SMTP présente un certificat non reconnu
SMTP_TLS_REJECT_UNAUTHORIZED=true
